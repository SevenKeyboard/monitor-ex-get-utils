<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>2.0.0</Version>
    <RootNamespace>SevenKeyboard</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <DisplayMonitorInfoManagerProjectPath Condition="'$(DisplayMonitorInfoManagerProjectPath)' == ''">$(MSBuildThisFileDirectory)../../../../display-monitor-info-manager/main-cs/src/SevenKeyboard.DisplayMonitorInfoManager/SevenKeyboard.DisplayMonitorInfoManager.csproj</DisplayMonitorInfoManagerProjectPath>
    <LibraryBuildTargetsPath Condition="'$(LibraryBuildTargetsPath)' == ''">$(MSBuildThisFileDirectory)../../../../library-build/main-cs/CheckLibraryVersions.targets</LibraryBuildTargetsPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(DisplayMonitorInfoManagerProjectPath)" MinimumVersion="2.0.0" />
    <InternalsVisibleTo Include="MonitorExGetUtils.Tests" />
  </ItemGroup>
  <Import Project="$(LibraryBuildTargetsPath)" />
</Project>